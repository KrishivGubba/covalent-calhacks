# Copy to `.env` and fill in. NEVER commit the real .env.
# cp .env.example .env

# ---- LLM providers ----
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=            # alias used by some modules
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# Local model fallback (optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Model routing
GATEWAY_MODEL=
AI_FALLBACK_CHAIN=

# ---- Agent-S (screen control / grounding) ----
AGENT_S_PROVIDER=
AGENT_S_MODEL=
AGENT_S_MODEL_TEMPERATURE=0.0
AGENT_S_PLATFORM=darwin
AGENT_S_GROUNDING_PROVIDER=
AGENT_S_GROUNDING_MODEL=
AGENT_S_GROUNDING_URL=

# ---- OAuth integrations ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
NOTION_CLIENT_ID=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
SLACK_CLIENT_ID=

# ---- Auth0 ----
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
VITE_AUTH0_CLIENT_ID=

# ---- AWS / gateway ----
GATEWAY_URL=
LAMBDA_GATEWAY_URL=
BUDGET_TABLE_NAME=
DEFAULT_BUDGET_LIMIT=

# ---- Local paths & runtime ----
COVALENT_DATA_DIR=
GRAPH_DB_PATH=
VITE_FLASK_PORT=5001
USER_ID=

# ---- Debug flags ----
COVALENT_DEBUG=false
DEBUG_PROMPTS=false
TAB_DEBUG=false
MOUNT_MCP_SERVER=false
