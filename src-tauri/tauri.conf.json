{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Covalent",
  "version": "0.1.0",
  "identifier": "com.hem.src-tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Covalent",
        "width": 550,
        "height": 450,
        "x": 0,
        "y": 50,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false,
        "contentProtected": false,
        "focus": false,
        "acceptFirstMouse": true,
        "titleBarStyle": "Transparent"
      },
      {
        "label": "ghost-text",
        "title": "Ghost Text",
        "url": "ghost-text.html",
        "width": 400,
        "height": 50,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": true,
        "center": false,
        "contentProtected": false,
        "focus": false,
        "acceptFirstMouse": false,
        "titleBarStyle": "Transparent"
      },
      {
        "label": "completion-popup",
        "title": "Completion",
        "url": "completion-popup.html",
        "width": 500,
        "height": 200,
        "x": 200,
        "y": 200,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": true,
        "center": false,
        "contentProtected": false,
        "focus": false,
        "acceptFirstMouse": true,
        "titleBarStyle": "Transparent",
        "parent": null
      },
      {
        "label": "dashboard",
        "title": "Covalent Dashboard",
        "url": "dashboard.html",
        "width": 1000,
        "height": 700,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "center": true,
        "contentProtected": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:* https://*.auth0.com https://*.amazonaws.com; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist-servers/flask-server/**/*": "servers/flask-server/",
      "../dist-servers/mcp-server/**/*": "servers/mcp-server/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "UPDATER_PUBKEY_PLACEHOLDER",
      "endpoints": [
        "https://github.com/hem8705/covalent-calhacks/releases/latest/download/latest.json"
      ]
    }
  }
}
